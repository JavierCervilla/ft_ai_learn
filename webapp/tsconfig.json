{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "//": "src/sw.ts va aparte: un service worker no puede compartir `lib` con el DOM (su `self` es ServiceWorkerGlobalScope, no Window). Ver tsconfig.sw.json.",
  "include": ["src", "tests", "vite.config.ts", "vite.sw.config.ts"],
  "exclude": ["src/sw.ts"]
}
