# Copia a `.env` para desarrollo local. El `.env` real NUNCA se commitea (ver .gitignore).
# En producción estas variables las pone Dokploy por entorno: no viven en el repo ni se imprimen.

# Postgres local levantado con `docker compose up -d`
DATABASE_URL=postgres://ftai:devpass@localhost:5433/ftai_dev

# Puerto del servidor
PORT=8000

# Raíz de los estáticos que sirve el backend (el bundle de la webapp)
STATIC_ROOT=webapp/dist
